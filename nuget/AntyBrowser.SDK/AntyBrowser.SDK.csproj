<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>AntyBrowser.SDK</PackageId>
    <Version>1.0.2</Version>
    <Authors>Antybrowser Team</Authors>
    <Company>AntyBrowser</Company>
    <Title>AntyBrowser .NET SDK - Anti-Detect Browser Automation</Title>
    <Description>The official Antybrowser .NET SDK for advanced anti-detect browser management, automation, and multi-accounting. Control browser profiles, manage fingerprints, automate workflows, and handle proxies with ease. Built for performance and SEO-friendly browser automation.</Description>
    <PackageTags>antidetect browser automation antybrowser multi-accounting fingerprinting web-scraping proxy-management selenium-alternative dotnet-sdk</PackageTags>
    <PackageProjectUrl>https://antybrowser.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/antybrowser/SDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIconUrl>https://antybrowser.com/icon.png</PackageIconUrl>
    <PackageReleaseNotes>Initial release of the Antybrowser .NET SDK with support for profiles, automations, proxies, and extensions.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Copyright>Copyright © 2026 Antybrowser</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
