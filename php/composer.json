{
    "name": "antybrowser/sdk",
    "description": "Official AntyBrowser SDK — PHP client for the AntyBrowser Local API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AntyBrowser Team",
            "email": "support@antybrowser.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AntyBrowser\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AntyBrowser\\SDK\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "antybrowser",
        "anti-detect",
        "browser-automation",
        "fingerprint",
        "multi-accounting"
    ],
    "homepage": "https://antybrowser.com",
    "support": {
        "issues": "https://github.com/AntyBrowser/AntyBrowser.SDK/issues",
        "source": "https://github.com/AntyBrowser/AntyBrowser.SDK"
    }
}
